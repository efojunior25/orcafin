JWT_SECRET=troque-por-uma-string-base64-longa-e-aleatoria
DB_PASSWORD=troque-por-uma-senha-forte-e-aleatoria
# Chave compartilhada entre o backend e o whatsapp-bot (rotas /api/internal/**).
INTERNAL_API_KEY=troque-por-uma-chave-forte-e-aleatoria

# Envio de email (recuperação de senha, boas-vindas) via Gmail SMTP.
# MAIL_APP_PASSWORD é a "senha de app" gerada em myaccount.google.com/apppasswords
# (exige verificação em 2 etapas ativada na conta), não a senha normal do Gmail.
MAIL_USERNAME=seuemail@gmail.com
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=OrçaFin Suporte
